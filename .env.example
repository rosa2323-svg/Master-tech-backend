# ---- Obligatorias ----
# Mínimo 32 caracteres. El bot debe usar el MISMO valor.
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres

# PostgreSQL (Supabase)
DB_URL=jdbc:postgresql://HOST:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=

# Stripe (modo de prueba)
STRIPE_SECRET_KEY=sk_test_...

# Supabase Storage (la service_role SOLO en el servidor)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=

# ---- Opcionales ----
FRONTEND_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://herramientas01.onrender.com
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Vacío = webhook desactivado
STRIPE_WEBHOOK_SECRET=
# Entre 30 y 1440
STRIPE_CHECKOUT_EXPIRACION_MINUTOS=30
SUPABASE_BUCKET_PRODUCTOS=Productos
# Clave de SERVIDOR (Routes API + direcciones). Vacía = línea recta y sin autocompletado
GOOGLE_MAPS_SERVER_KEY=
PORT=8089
